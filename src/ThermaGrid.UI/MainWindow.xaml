<Window x:Class="ThermaGrid.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThermaGrid — AMR Heat Solver" Height="700" Width="1100"
        Background="#1E1E1E">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- Heatmap display -->
        <Border Grid.Column="0" BorderBrush="#444" BorderThickness="1">
            <Image x:Name="HeatmapImage" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <!-- Controls -->
        <StackPanel Grid.Column="1" Margin="10,0,0,0">

            <TextBlock Text="ThermaGrid" FontSize="22" FontWeight="Bold"
                       Foreground="White" Margin="0,0,0,10"/>

            <Button x:Name="StartButton" Content="▶ Start" Click="OnStart"
                    Margin="0,5" Padding="10" FontSize="14"/>

            <Button x:Name="StopButton" Content="⏹ Stop" Click="OnStop"
                    Margin="0,5" Padding="10" FontSize="14" IsEnabled="False"/>

            <Button x:Name="ResetButton" Content="↺ Reset" Click="OnReset"
                    Margin="0,5" Padding="10" FontSize="14"/>

            <Separator Margin="0,15"/>

            <TextBlock Text="Info" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
            <TextBlock x:Name="TimeText" Foreground="#CCC" Text="Time: 0.000 s"/>
            <TextBlock x:Name="CellsText" Foreground="#CCC" Text="Cells: 0"/>
            <TextBlock x:Name="MinMaxText" Foreground="#CCC" Text="Range: 0 – 0 °C"/>

            <Separator Margin="0,15"/>

            <TextBlock Text="Legend" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
            <TextBlock Text="Blue = cold (20°C)" Foreground="#888"/>
            <TextBlock Text="Red  = hot (300°C)" Foreground="#888"/>
        </StackPanel>
    </Grid>
</Window>