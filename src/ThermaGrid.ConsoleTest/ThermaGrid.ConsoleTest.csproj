<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Force x64 to match the native DLL -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Recommended for P/Invoke with C++ DLLs -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Copy the native DLL(s) to the output directory -->
  <ItemGroup>
    <!-- Main ThermaGrid DLL -->
    <None Include="..\..\cmake-build-release\bin\ThermaGrid_Core.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ThermaGrid_Core.dll</Link>
    </None>

    <!-- MinGW runtime DLLs (only needed if built with MinGW) -->
    <None Include="C:\Program Files\JetBrains\CLion 2026.1.3\bin\mingw\bin\libgcc_s_seh-1.dll"
          Condition="Exists('C:\Program Files\JetBrains\CLion 2026.1.3\bin\mingw\bin\libgcc_s_seh-1.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libgcc_s_seh-1.dll</Link>
    </None>

    <None Include="C:\Program Files\JetBrains\CLion 2026.1.3\bin\mingw\bin\libstdc++-6.dll"
          Condition="Exists('C:\Program Files\JetBrains\CLion 2026.1.3\bin\mingw\bin\libstdc++-6.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libstdc++-6.dll</Link>
    </None>

    <None Include="C:\Program Files\JetBrains\CLion 2026.1.3\bin\mingw\bin\libwinpthread-1.dll"
          Condition="Exists('C:\Program Files\JetBrains\CLion 2026.1.3\bin\mingw\bin\libwinpthread-1.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libwinpthread-1.dll</Link>
    </None>
  </ItemGroup>

</Project>